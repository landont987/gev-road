<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Asks the GPS chip for assistance data at start (GpsWatch): a cold fix in seconds, not minutes. -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!-- Spoken "hotspot connection lost" and the AI voice's online check. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The plate-reader detector plugs into USB; the app works without it. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- Android 11+ hides other apps unless declared; the built-in voice needs the TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GEV Road"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Engine data from the separate AndrOBD app: it finds GEV Road through this
             receiver and starts the service with its live data (see AndrobdPlugin). -->
        <receiver
            android:name=".AndrobdPlugin"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fr3ts0n.androbd.plugin.IDENTIFY" />
                <category android:name="com.fr3ts0n.androbd.plugin.REQUEST" />
            </intent-filter>
        </receiver>
        <service
            android:name=".EngineDataService"
            android:exported="true" />

        <!-- Off until the driver turns it on in the app (Detector.setAutoOpen): opens
             GEV Road when the plate-reader detector (an ESP32-S3 USB board) is plugged
             in, and lets Android remember the USB permission ("use by default"). -->
        <activity-alias
            android:name=".DetectorPlugged"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/detector_usb" />
        </activity-alias>
    </application>
</manifest>
